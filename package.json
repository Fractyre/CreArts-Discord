{
  "name": "crearts-discord",
  "version": "3.0.3",
  "description": "CreArts is a customizable Discord theme that changes the appearance of Discord.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "sass --no-source-map --style=compressed src/source.scss:src/source.css modules/custom/private.scss:modules/custom/private.css modules/custom/server.scss:modules/custom/server.css modules/custom/user.scss:modules/custom/user.css modules/custom/tags.scss:modules/custom/tags.css",
    "dev": "node scripts/dev.js",
    "check-classes": "node scripts/check-classes.js",
    "lint": "prettier ./src --check",
    "lint:fix": "prettier ./src --write"
  },
  "keywords": [],
  "author": "CorellanStoma",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^2.8.7",
    "sass": "^1.80.0"
  }
}
